# EditorConfig: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = tab
indent_size = 4

[*.{xml,properties}]
indent_style = tab
indent_size = 4

[*.{js,json,html,css}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false
